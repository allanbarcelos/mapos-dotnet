@page "{id:int}"
@model mapos_dotnet.Pages.Vendas.VisualizarModel
@{
    ViewData["Title"] = $"Venda #{Model.Venda.Id}";
    var v = Model.Venda;
}

<div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
        <a href="/Vendas" class="text-gray-400 hover:text-gray-600"><i class='bx bx-arrow-back text-xl'></i></a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Venda #@v.Id</h1>
            <p class="text-sm text-gray-500">@v.Cliente.NomeCliente · @v.DataVenda.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
    <div class="flex gap-2">
        <a href="/Vendas/Imprimir/@v.Id" target="_blank" class="btn-secondary btn-sm"><i class='bx bx-printer'></i> Imprimir</a>
        @if (!v.Faturado)
        {
            <a href="/Vendas/Editar/@v.Id" class="btn-secondary btn-sm"><i class='bx bx-edit'></i> Editar</a>
            <form method="post" asp-page-handler="Faturar">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-success btn-sm"
                        onclick="return confirm('Confirmar faturamento?')">
                    <i class='bx bx-check'></i> Faturar
                </button>
            </form>
        }
        else
        {
            <span class="badge-green">Faturada</span>
        }
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Info -->
    <div class="lg:col-span-1 space-y-4">
        <div class="card card-body space-y-3 text-sm">
            <div><span class="text-gray-500">Cliente:</span> <span class="font-medium">@v.Cliente.NomeCliente</span></div>
            <div><span class="text-gray-500">Status:</span> <span class="font-medium">@v.Status</span></div>
            <div><span class="text-gray-500">Data:</span> <span class="font-medium">@v.DataVenda.ToString("dd/MM/yyyy")</span></div>
            <div><span class="text-gray-500">Subtotal:</span> <span class="font-medium">@v.Itens.Sum(i => i.SubTotal).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</span></div>
            <div><span class="text-gray-500">Desconto:</span> <span class="font-medium">@v.ValorDesconto.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</span></div>
            <div class="border-t pt-3"><span class="text-gray-500">Total:</span> <span class="text-lg font-bold text-primary-600">@v.ValorTotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</span></div>
        </div>

        <!-- Desconto -->
        @if (!v.Faturado)
        {
        <div class="card">
            <div class="card-header"><h3 class="font-semibold text-sm">Aplicar Desconto</h3></div>
            <div class="card-body">
                <form method="post" asp-page-handler="AdicionarDesconto">
                    @Html.AntiForgeryToken()
                    <div class="space-y-3">
                        <div>
                            <label class="form-label">Tipo</label>
                            <select asp-for="TipoDesconto" class="form-select">
                                <option value="real">Valor (R$)</option>
                                <option value="percent">Percentual (%)</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Valor</label>
                            <div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="DescontoValor" class="form-input pl-9" placeholder="0,00" /></div>
                        </div>
                        <button type="submit" class="btn-primary btn-sm w-full justify-center">Aplicar</button>
                    </div>
                </form>
            </div>
        </div>
        }

        <!-- Gerar Boleto MercadoPago -->
        @if (Model.MpConfigurado)
        {
            <div class="card">
                <div class="card-header"><h3 class="font-semibold text-sm">Cobrança MercadoPago</h3></div>
                <div class="card-body space-y-2">
                    @if (v.Cobrancas.Any(c => c.PaymentGateway == "mercadopago"))
                    {
                        @foreach (var c in v.Cobrancas.Where(c => c.PaymentGateway == "mercadopago").OrderByDescending(c => c.Id))
                        {
                            <div class="text-xs flex justify-between items-center">
                                <a href="/Cobrancas/Visualizar/@c.Id" class="text-primary-600 hover:underline">Cobrança #@c.Id</a>
                                <span>@c.Status</span>
                            </div>
                        }
                    }
                    <form method="post" asp-page-handler="GerarBoleto"
                          onsubmit="return confirm('Gerar boleto MercadoPago para esta venda?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-primary btn-sm w-full justify-center">
                            <i class='bx bx-barcode'></i> Gerar Boleto
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Produtos -->
    <div class="lg:col-span-2 space-y-4">
        <div class="card">
            <div class="card-header">
                <h3 class="font-semibold">Produtos</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="table-mapos">
                    <thead><tr><th>Produto</th><th>Qtd</th><th>Preço Unit.</th><th>Subtotal</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in v.Itens)
                    {
                        <tr>
                            <td>@item.Produto.Descricao</td>
                            <td>@item.Quantidade</td>
                            <td>@item.Preco.ToString("N2")</td>
                            <td>@item.SubTotal.ToString("N2")</td>
                            <td>
                                @if (!v.Faturado)
                                {
                                    <form method="post" asp-page-handler="ExcluirProduto" asp-route-itemId="@item.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-red-500 hover:text-red-700">
                                            <i class='bx bx-trash'></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!v.Itens.Any()) { <tr><td colspan="5" class="text-center text-gray-400 py-4">Nenhum produto adicionado</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (!v.Faturado)
            {
            <div class="card-body border-t">
                <form method="post" asp-page-handler="AdicionarProduto" class="flex gap-3 items-end flex-wrap">
                    @Html.AntiForgeryToken()
                    <div class="flex-1 min-w-40">
                        <label class="form-label">Produto</label>
                        <select asp-for="AddProdutoId" class="form-select">
                            <option value="">Selecione...</option>
                            @foreach (var p in Model.Produtos)
                            {
                                <option value="@p.Id" data-preco="@p.PrecoVenda.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.Descricao</option>
                            }
                        </select>
                    </div>
                    <div class="w-20">
                        <label class="form-label">Qtd</label>
                        <input asp-for="AddQuantidade" type="number" min="1" class="form-input" />
                    </div>
                    <div class="w-32">
                        <label class="form-label">Preço</label>
                        <div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="AddPreco" class="form-input pl-9" id="addPreco"  placeholder="0,00" /></div>
                    </div>
                    <button type="submit" class="btn-primary btn-sm"><i class='bx bx-plus'></i> Adicionar</button>
                </form>
            </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelector('[id="AddProdutoId"]')?.addEventListener('change', function() {
    const opt = this.options[this.selectedIndex];
    const preco = opt?.dataset?.preco;
    if (preco) document.getElementById('addPreco').value = parseFloat(preco).toFixed(2);
});
</script>
}
