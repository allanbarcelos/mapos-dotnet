@page "{id:int}"
@model mapos_dotnet.Pages.Vendas.EditarModel
@{ ViewData["Title"] = "Editar Venda"; }

<div class="flex items-center gap-3 mb-6">
    <a href="/Vendas" class="text-gray-400 hover:text-gray-600"><i class='bx bx-arrow-back text-xl'></i></a>
    <h1 class="text-2xl font-bold text-gray-900">Editar Venda #@Model.Input.Id</h1>
</div>

<div class="card max-w-2xl">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Input.Id" type="hidden" />
            <div class="space-y-5">
                <div>
                    <label asp-for="Input.ClienteId" class="form-label">Cliente <span class="text-red-500">*</span></label>
                    <select asp-for="Input.ClienteId" class="form-select">
                        @foreach (var c in Model.Clientes)
                        { <option value="@c.Id">@c.NomeCliente</option> }
                    </select>
                </div>
                <div>
                    <label asp-for="Input.DataVenda" class="form-label">Data</label>
                    <input asp-for="Input.DataVenda" type="date" class="form-input" />
                </div>
                <div>
                    <label asp-for="Input.Status" class="form-label">Status</label>
                    <select asp-for="Input.Status" class="form-select">
                        <option>Aberto</option><option>Concluído</option><option>Cancelado</option>
                    </select>
                </div>
                <div>
                    <label asp-for="Input.Observacoes" class="form-label">Observações</label>
                    <textarea asp-for="Input.Observacoes" rows="3" class="form-input"></textarea>
                </div>
                <div>
                    <label asp-for="Input.ObservacoesCliente" class="form-label">Observações para o Cliente</label>
                    <textarea asp-for="Input.ObservacoesCliente" rows="3" class="form-input"></textarea>
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button type="submit" class="btn-primary"><i class='bx bx-save'></i> Salvar</button>
                <a href="/Vendas" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
