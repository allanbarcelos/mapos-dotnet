<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "PDV")</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="antialiased bg-gray-50 min-h-screen">

<div class="flex items-center gap-3 px-6 py-4 bg-white border-b border-gray-200 shadow-sm">
    <div class="w-8 h-8 bg-green-600 rounded-lg flex items-center justify-center flex-shrink-0">
        <i class='bx bx-store text-white text-lg'></i>
    </div>
    <h1 class="text-lg font-bold text-gray-800">PDV</h1>
    <span class="text-gray-300">|</span>
    <span class="text-sm text-gray-500">@ViewData["Title"]</span>
    <div class="ml-auto flex items-center gap-2">
        <a href="/Account/Logout"
           class="flex items-center gap-1.5 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 rounded-lg transition-colors">
            <i class='bx bx-log-out-circle'></i>
            Sair
        </a>
    </div>
</div>

<main class="max-w-2xl mx-auto px-4 py-8">
    @if (TempData["Success"] is string success)
    {
        <div class="mb-4 flex items-center gap-2 px-4 py-3 bg-green-50 border border-green-200 rounded-lg text-green-800 text-sm">
            <i class='bx bx-check-circle'></i> @success
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="mb-4 flex items-center gap-2 px-4 py-3 bg-red-50 border border-red-200 rounded-lg text-red-800 text-sm">
            <i class='bx bx-error-circle'></i> @error
        </div>
    }

    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
