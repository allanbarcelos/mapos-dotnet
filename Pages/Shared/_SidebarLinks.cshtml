@inject mapos_dotnet.Services.IPermissaoService PermissaoSvc
@{
    var _uidClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int _uid = int.TryParse(_uidClaim, out var _u) ? _u : 0;
    int permId = _uid > 0 ? await PermissaoSvc.GetPermissaoIdByUsuarioIdAsync(_uid) : 0;

    async Task<bool> Tem(string atividade) =>
        permId > 0 && await PermissaoSvc.TemPermissaoAsync(permId, atividade);

    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string prefix) => page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<a href="/" class="sidebar-link @Active("/Index")">
    <i class='bx bx-home-alt text-xl flex-shrink-0'></i>
    <span x-show="sidebarOpen">Home</span>
</a>

@if (await Tem("vCliente"))
{
    <a href="/Clientes" class="sidebar-link @Active("/Clientes")">
        <i class='bx bx-user text-xl flex-shrink-0'></i>
        <span x-show="sidebarOpen">Cliente / Fornecedor</span>
    </a>
}

