@model (int CurrentPage, int TotalPages, string BaseUrl)

@if (Model.TotalPages > 1)
{
    <nav class="flex items-center justify-between mt-4">
        <p class="text-sm text-gray-600">Página @Model.CurrentPage de @Model.TotalPages</p>
        <div class="flex gap-1">
            @if (Model.CurrentPage > 1)
            {
                <a href="@Model.BaseUrl?page=@(Model.CurrentPage - 1)"
                   class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 hover:bg-gray-50">
                    <i class='bx bx-chevron-left'></i>
                </a>
            }

            @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
            {
                <a href="@Model.BaseUrl?page=@i"
                   class="px-3 py-1.5 text-sm rounded-lg border @(i == Model.CurrentPage ? "bg-primary-600 text-white border-primary-600" : "border-gray-200 hover:bg-gray-50")">
                    @i
                </a>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a href="@Model.BaseUrl?page=@(Model.CurrentPage + 1)"
                   class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 hover:bg-gray-50">
                    <i class='bx bx-chevron-right'></i>
                </a>
            }
        </div>
    </nav>
}
