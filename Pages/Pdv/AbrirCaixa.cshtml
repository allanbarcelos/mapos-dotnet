@page
@model mapos_dotnet.Pages.Pdv.AbrirCaixaModel
@{
    ViewData["Title"] = "Abrir Caixa";
}

<div class="max-w-lg mx-auto mt-10">
    <div class="text-center mb-8">
        <div class="w-16 h-16 bg-green-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <i class='bx bx-store text-green-600 text-3xl'></i>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">Abrir Caixa</h1>
        <p class="text-sm text-gray-500 mt-1">Informe o saldo inicial para iniciar a sessão PDV</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="space-y-5">
                    <div>
                        <label asp-for="Input.SaldoInicial" class="form-label">
                            Saldo Inicial (dinheiro em caixa) <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Input.SaldoInicial" type="number" step="0.01" min="0"
                               class="form-input text-2xl font-bold text-center" placeholder="0,00" autofocus />
                        <span asp-validation-for="Input.SaldoInicial" class="form-error"></span>
                    </div>
                    <div>
                        <label asp-for="Input.PdvTerminalId" class="form-label">Terminal PDV <span class="text-red-500">*</span></label>
                        @if (!Model.Terminais.Any())
                        {
                            <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                                <i class='bx bx-error-circle mr-1'></i>
                                Nenhum terminal disponível. <a href="/Pdv/Terminais/Adicionar" class="underline">Cadastrar terminal</a>
                            </div>
                        }
                        else
                        {
                            <select asp-for="Input.PdvTerminalId" class="form-select">
                                <option value="">Selecione o terminal...</option>
                                @foreach (var t in Model.Terminais)
                                {
                                    <option value="@t.Id">@t.Nome@(string.IsNullOrEmpty(t.Descricao) ? "" : $" — {t.Descricao}")</option>
                                }
                            </select>
                            <span asp-validation-for="Input.PdvTerminalId" class="form-error"></span>
                        }
                    </div>
                    <div>
                        <label asp-for="Input.Observacoes" class="form-label">Observações</label>
                        <input asp-for="Input.Observacoes" class="form-input"
                               placeholder="Observações opcionais sobre a abertura" />
                    </div>
                </div>
                <div class="flex gap-3 mt-8">
                    <button type="submit" class="btn-primary flex-1 justify-center text-base py-3">
                        <i class='bx bx-door-open mr-2'></i> Abrir Caixa
                    </button>
                    <a href="/Pdv/Historico" class="btn-secondary">Histórico</a>
                </div>
            </form>
        </div>
    </div>
</div>
