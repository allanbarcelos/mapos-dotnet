@page "{id:int}"
@model mapos_dotnet.Pages.Contas.EditarModel
@{
    ViewData["Title"] = "Editar Conta";
}

<div class="flex items-center gap-3 mb-6">
    <a href="/Contas" class="text-gray-400 hover:text-gray-600">
        <i class='bx bx-arrow-back text-xl'></i>
    </a>
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Editar Conta</h1>
        <p class="text-sm text-gray-500 mt-0.5">Altere os dados da conta</p>
    </div>
</div>

<div class="card max-w-2xl">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="space-y-5">
                <div>
                    <label asp-for="Input.Nome" class="form-label">Nome <span class="text-red-500">*</span></label>
                    <input asp-for="Input.Nome" class="form-input" placeholder="Nome da conta" />
                    <span asp-validation-for="Input.Nome" class="form-error"></span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Input.Banco" class="form-label">Banco</label>
                        <input asp-for="Input.Banco" class="form-input" placeholder="Ex: Bradesco" />
                    </div>
                    <div>
                        <label asp-for="Input.NumeroAgencia" class="form-label">Agência / Número</label>
                        <input asp-for="Input.NumeroAgencia" class="form-input" placeholder="0001 / 12345-6" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Input.Tipo" class="form-label">Tipo</label>
                        <select asp-for="Input.Tipo" class="form-input">
                            <option value="">— Selecione —</option>
                            <option value="corrente">Conta Corrente</option>
                            <option value="poupanca">Poupança</option>
                            <option value="caixa">Caixa</option>
                            <option value="investimento">Investimento</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.Saldo" class="form-label">Saldo</label>
                        <div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="Input.Saldo" class="form-input pl-9" placeholder="0,00" /></div>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="Input.Status" type="checkbox" class="w-4 h-4" />
                    <label asp-for="Input.Status" class="form-label mb-0">Ativo</label>
                </div>
            </div>

            <div class="flex items-center gap-3 mt-8">
                <button type="submit" class="btn-primary">
                    <i class='bx bx-save mr-1'></i> Salvar Alterações
                </button>
                <a href="/Contas" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
