@page "{id:int}"
@model mapos_dotnet.Pages.Garantias.EditarModel
@{
    ViewData["Title"] = "Editar Garantia";
}

<div class="flex items-center gap-3 mb-6">
    <a href="/Garantias" class="text-gray-400 hover:text-gray-600">
        <i class='bx bx-arrow-back text-xl'></i>
    </a>
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Editar Garantia</h1>
        <p class="text-sm text-gray-500 mt-0.5">Garantia #@Model.Id</p>
    </div>
</div>

<div class="card max-w-3xl">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="space-y-5">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="Input.RefGarantia" class="form-label">Referência</label>
                        <input asp-for="Input.RefGarantia" class="form-input" placeholder="Ex.: GAR-001" />
                        <span asp-validation-for="Input.RefGarantia" class="form-error"></span>
                    </div>

                    <div>
                        <label asp-for="Input.DataGarantia" class="form-label">Data</label>
                        <input asp-for="Input.DataGarantia" type="date" class="form-input" />
                        <span asp-validation-for="Input.DataGarantia" class="form-error"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Input.TextoGarantia" class="form-label">Texto da Garantia <span class="text-red-500">*</span></label>
                    <textarea asp-for="Input.TextoGarantia" rows="10" class="form-input"
                              placeholder="Descreva os termos e condições da garantia..."></textarea>
                    <span asp-validation-for="Input.TextoGarantia" class="form-error"></span>
                </div>
            </div>

            <div class="flex items-center gap-3 mt-8">
                <button type="submit" class="btn-primary">
                    <i class='bx bx-save mr-1'></i> Salvar Alterações
                </button>
                <a href="/Garantias" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
