@page
@model mapos_dotnet.Pages.Mine.OsModel
@{
    ViewData["Title"] = "Minhas OS";
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Minhas Ordens de Serviço</h1>
        <p class="text-sm text-gray-500 mt-0.5">Acompanhe o andamento das suas OS</p>
    </div>
    <a href="/Mine/AdicionarOs" class="btn-primary">
        <i class='bx bx-plus mr-1'></i> Abrir Nova OS
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table-mapos">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Data</th>
                    <th>Defeito</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-8 text-gray-400">Nenhuma OS encontrada.</td>
                    </tr>
                }
                @{
                    var ptBR = new System.Globalization.CultureInfo("pt-BR");
                }
                @foreach (var os in Model.Items)
                {
                    <tr>
                        <td class="text-gray-500 font-medium">#@os.Id</td>
                        <td class="text-xs text-gray-500">@os.DataInicial?.ToString("dd/MM/yyyy")</td>
                        <td class="text-sm text-gray-700 max-w-xs truncate">@(os.Defeito ?? "—")</td>
                        <td><span class="text-xs font-medium">@os.Status</span></td>
                        <td class="text-sm font-medium">@os.ValorTotal.ToString("C", ptBR)</td>
                        <td>
                            <a href="/Mine/VisualizarOs/@os.Id" class="btn-secondary btn-sm">
                                <i class='bx bx-show mr-1'></i> Ver
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer flex justify-center gap-1">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="?page=@i"
                   class="px-3 py-1 text-sm rounded @(i == Model.Page ? "bg-primary-600 text-white" : "bg-white border border-gray-200 text-gray-700 hover:bg-gray-50")">
                    @i
                </a>
            }
        </div>
    }
</div>
