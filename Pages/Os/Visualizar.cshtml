@page "{id:int}"
@model mapos_dotnet.Pages.Os.VisualizarModel
@{
    ViewData["Title"] = $"OS #{Model.Os.Id}";
    var os = Model.Os;
    var ptBR = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
        <a href="/Os" class="text-gray-400 hover:text-gray-600"><i class='bx bx-arrow-back text-xl'></i></a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900">OS #@os.Id</h1>
            <p class="text-sm text-gray-500">@os.Cliente.NomeCliente · @os.DataInicial?.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
    <div class="flex gap-2">
        @if (!os.Faturado)
        {
            <a href="/Os/Editar/@os.Id" class="btn-secondary btn-sm"><i class='bx bx-edit'></i> Editar</a>
            <form method="post" asp-page-handler="Faturar">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-success btn-sm" onclick="return confirm('Confirmar faturamento?')">
                    <i class='bx bx-check-circle'></i> Faturar
                </button>
            </form>
        }
        else
        {
            <span class="badge-green text-sm px-3 py-1">Faturada</span>
        }
        <a href="/Os/Imprimir/@os.Id" target="_blank" class="btn-secondary btn-sm"><i class='bx bx-printer'></i> Imprimir</a>
    </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <!-- Coluna esquerda: info + desconto + notas -->
    <div class="space-y-4">
        <!-- Info principal -->
        <div class="card card-body text-sm space-y-2">
            <div class="flex justify-between"><span class="text-gray-500">Cliente</span><span class="font-medium">@os.Cliente.NomeCliente</span></div>
            <div class="flex justify-between"><span class="text-gray-500">Técnico</span><span class="font-medium">@os.Usuario.Nome</span></div>
            <div class="flex justify-between"><span class="text-gray-500">Status</span><span class="font-medium">@os.Status</span></div>
            <div class="flex justify-between"><span class="text-gray-500">Abertura</span><span class="font-medium">@os.DataInicial?.ToString("dd/MM/yyyy")</span></div>
            @if (os.DataFinal.HasValue) {
            <div class="flex justify-between"><span class="text-gray-500">Previsão</span><span class="font-medium">@os.DataFinal?.ToString("dd/MM/yyyy")</span></div>
            }
            <div class="flex justify-between"><span class="text-gray-500">Garantia</span><span class="font-medium">@(os.Garantia ?? "-")</span></div>
            <div class="border-t pt-2 flex justify-between"><span class="text-gray-500">Total</span>
                <span class="font-bold text-primary-600 text-base">@os.ValorTotal.ToString("C", ptBR)</span></div>
        </div>

        @if (!string.IsNullOrEmpty(os.Defeito)) {
        <div class="card card-body text-sm">
            <p class="text-gray-500 font-medium mb-1">Defeito Relatado</p>
            <p>@os.Defeito</p>
        </div>
        }
        @if (!string.IsNullOrEmpty(os.LaudoTecnico)) {
        <div class="card card-body text-sm">
            <p class="text-gray-500 font-medium mb-1">Laudo Técnico</p>
            <p>@os.LaudoTecnico</p>
        </div>
        }

        <!-- Desconto -->
        @if (!os.Faturado) {
        <div class="card">
            <div class="card-header"><h3 class="text-sm font-semibold">Aplicar Desconto</h3></div>
            <div class="card-body">
                <form method="post" asp-page-handler="AdicionarDesconto" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="form-label">Tipo</label>
                        <select asp-for="TipoDesconto" class="form-select">
                            <option value="real">Valor (R$)</option>
                            <option value="percent">Percentual (%)</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Valor</label>
                        <div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="DescontoValor" class="form-input pl-9" placeholder="0,00" /></div>
                    </div>
                    <button type="submit" class="btn-primary btn-sm w-full justify-center">Aplicar</button>
                </form>
            </div>
        </div>
        }

        <!-- Gerar Boleto MercadoPago -->
        @if (Model.MpConfigurado)
        {
            <div class="card">
                <div class="card-header"><h3 class="text-sm font-semibold">Cobrança MercadoPago</h3></div>
                <div class="card-body space-y-2">
                    @if (os.Cobrancas.Any(c => c.PaymentGateway == "mercadopago"))
                    {
                        @foreach (var c in os.Cobrancas.Where(c => c.PaymentGateway == "mercadopago").OrderByDescending(c => c.Id))
                        {
                            <div class="text-xs flex justify-between items-center">
                                <a href="/Cobrancas/Visualizar/@c.Id" class="text-primary-600 hover:underline">Cobrança #@c.Id</a>
                                <span>@c.Status</span>
                            </div>
                        }
                    }
                    <form method="post" asp-page-handler="GerarBoleto"
                          onsubmit="return confirm('Gerar boleto MercadoPago para esta OS?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-primary btn-sm w-full justify-center">
                            <i class='bx bx-barcode'></i> Gerar Boleto
                        </button>
                    </form>
                </div>
            </div>
        }

        <!-- Anotações -->
        <div class="card">
            <div class="card-header"><h3 class="text-sm font-semibold">Anotações</h3></div>
            <div class="card-body space-y-2">
                @foreach (var nota in os.Anotacoes.OrderByDescending(a => a.DataHora)) {
                <div class="flex items-start justify-between gap-2 text-sm border-b pb-2 last:border-0">
                    <div>
                        <p>@nota.Anotacao</p>
                        <p class="text-xs text-gray-400">@nota.DataHora.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <form method="post" asp-page-handler="ExcluirAnotacao" asp-route-anotacaoId="@nota.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="text-red-400 hover:text-red-600 text-xs"><i class='bx bx-x'></i></button>
                    </form>
                </div>
                }
                <form method="post" asp-page-handler="AdicionarAnotacao" class="flex gap-2 mt-2">
                    @Html.AntiForgeryToken()
                    <input asp-for="Anotacao" type="text" class="form-input text-sm" placeholder="Adicionar anotação..." />
                    <button type="submit" class="btn-primary btn-sm"><i class='bx bx-send'></i></button>
                </form>
            </div>
        </div>
    </div>

    <!-- Coluna direita: produtos, serviços, anexos -->
    <div class="xl:col-span-2 space-y-4">
        <!-- Produtos -->
        <div class="card">
            <div class="card-header"><h3 class="font-semibold">Produtos</h3></div>
            <div class="overflow-x-auto">
                <table class="table-mapos">
                    <thead><tr><th>Produto</th><th>Qtd</th><th>Preço</th><th>Subtotal</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var p in os.ProdutosOs) {
                        <tr>
                            <td>@p.Descricao</td>
                            <td>@p.Quantidade</td>
                            <td>@p.Preco.ToString("N2")</td>
                            <td>@p.SubTotal.ToString("N2")</td>
                            <td>
                                @if (!os.Faturado) {
                                <form method="post" asp-page-handler="ExcluirProduto" asp-route-itemId="@p.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-red-400 hover:text-red-600"><i class='bx bx-trash text-sm'></i></button>
                                </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!os.ProdutosOs.Any()) { <tr><td colspan="5" class="text-center text-gray-400 py-3 text-sm">Nenhum produto</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (!os.Faturado) {
            <div class="card-body border-t">
                <form method="post" asp-page-handler="AdicionarProduto" class="flex gap-2 flex-wrap items-end">
                    @Html.AntiForgeryToken()
                    <div class="flex-1 min-w-36">
                        <label class="form-label text-xs">Produto</label>
                        <select asp-for="AddProdutoId" class="form-select text-sm" id="selProd">
                            <option value="">Selecione...</option>
                            @foreach (var p in Model.Produtos) {
                                <option value="@p.Id" data-preco="@p.PrecoVenda.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.Descricao</option>
                            }
                        </select>
                    </div>
                    <div class="w-16"><label class="form-label text-xs">Qtd</label><input asp-for="AddProdQtd" type="number" min="1" class="form-input text-sm" /></div>
                    <div class="w-28"><label class="form-label text-xs">Preço</label><div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="AddProdPreco" id="prodPreco" class="form-input text-sm pl-9"  placeholder="0,00" /></div></div>
                    <button type="submit" class="btn-primary btn-sm"><i class='bx bx-plus'></i></button>
                </form>
            </div>
            }
        </div>

        <!-- Serviços -->
        <div class="card">
            <div class="card-header"><h3 class="font-semibold">Serviços</h3></div>
            <div class="overflow-x-auto">
                <table class="table-mapos">
                    <thead><tr><th>Serviço</th><th>Qtd</th><th>Preço</th><th>Subtotal</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var s in os.ServicosOs) {
                        <tr>
                            <td>@s.Servico</td>
                            <td>@s.Quantidade</td>
                            <td>@s.Preco.ToString("N2")</td>
                            <td>@s.SubTotal.ToString("N2")</td>
                            <td>
                                @if (!os.Faturado) {
                                <form method="post" asp-page-handler="ExcluirServico" asp-route-itemId="@s.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-red-400 hover:text-red-600"><i class='bx bx-trash text-sm'></i></button>
                                </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!os.ServicosOs.Any()) { <tr><td colspan="5" class="text-center text-gray-400 py-3 text-sm">Nenhum serviço</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (!os.Faturado) {
            <div class="card-body border-t">
                <form method="post" asp-page-handler="AdicionarServico" class="flex gap-2 flex-wrap items-end">
                    @Html.AntiForgeryToken()
                    <div class="flex-1 min-w-36">
                        <label class="form-label text-xs">Serviço</label>
                        <select asp-for="AddServicoId" class="form-select text-sm" id="selSvc">
                            <option value="">Selecione...</option>
                            @foreach (var s in Model.Servicos) {
                                <option value="@s.Id" data-preco="@s.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)">@s.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="w-16"><label class="form-label text-xs">Qtd</label><input asp-for="AddServQtd" type="number" step="0.5" min="0.5" class="form-input text-sm" /></div>
                    <div class="w-28"><label class="form-label text-xs">Preço</label><div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="AddServPreco" id="svcPreco" class="form-input text-sm pl-9"  placeholder="0,00" /></div></div>
                    <button type="submit" class="btn-primary btn-sm"><i class='bx bx-plus'></i></button>
                </form>
            </div>
            }
        </div>

        <!-- Anexos -->
        <div class="card">
            <div class="card-header"><h3 class="font-semibold">Anexos</h3></div>
            <div class="card-body space-y-2">
                @foreach (var a in os.Anexos) {
                <div class="flex items-center justify-between text-sm border rounded-lg px-3 py-2">
                    <a href="@a.Url" target="_blank" class="text-primary-600 hover:underline flex items-center gap-2">
                        <i class='bx bx-file'></i> @a.NomeArquivo
                    </a>
                    <form method="post" asp-page-handler="ExcluirAnexo" asp-route-anexoId="@a.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="text-red-400 hover:text-red-600"><i class='bx bx-trash text-sm'></i></button>
                    </form>
                </div>
                }
                <form method="post" asp-page-handler="Anexar" enctype="multipart/form-data" class="flex gap-2 mt-2">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" class="form-input text-sm flex-1" />
                    <button type="submit" class="btn-secondary btn-sm"><i class='bx bx-upload'></i> Enviar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('selProd')?.addEventListener('change', function() {
    const p = this.options[this.selectedIndex]?.dataset?.preco;
    if (p) document.getElementById('prodPreco').value = parseFloat(p).toFixed(2);
});
document.getElementById('selSvc')?.addEventListener('change', function() {
    const p = this.options[this.selectedIndex]?.dataset?.preco;
    if (p) document.getElementById('svcPreco').value = parseFloat(p).toFixed(2);
});
</script>
}
