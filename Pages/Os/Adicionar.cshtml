@page
@model mapos_dotnet.Pages.Os.AdicionarModel
@{
    ViewData["Title"] = "Nova OS";
}

<div class="flex items-center gap-3 mb-6">
    <a href="/Os" class="text-gray-500 hover:text-gray-700">
        <i class='bx bx-arrow-back text-xl'></i>
    </a>
    <h1 class="text-2xl font-bold text-gray-900">Nova Ordem de Serviço</h1>
</div>

<form method="post" class="space-y-6" x-data="osAdicionar()">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header">
            <h2 class="font-semibold text-gray-700">Dados da OS</h2>
        </div>
        <div class="card-body grid grid-cols-1 md:grid-cols-2 gap-5">

            <!-- Cliente -->
            <div class="md:col-span-2">
                <label asp-for="ClienteId" class="form-label">Cliente <span class="text-red-500">*</span></label>
                <div class="relative" x-data="{ search: '', open: false, selected: '' }">
                    <input type="text" x-model="search"
                           @@focus="open = true"
                           @@click.outside="open = false"
                           placeholder="Digite para buscar cliente..."
                           class="form-input"
                           autocomplete="off" />
                    <input type="hidden" asp-for="ClienteId" x-bind:value="$el.form.querySelector('[name=ClienteId]')?.value" />
                    <div x-show="open && search.length >= 1"
                         class="absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-60 overflow-y-auto">
                        @foreach (var c in Model.Clientes)
                        {
                            <button type="button"
                                    class="w-full text-left px-4 py-2 text-sm hover:bg-gray-50"
                                    x-show="'@c.NomeCliente.ToLower()'.includes(search.toLowerCase())"
                                    @@click="
                                        search = '@c.NomeCliente.Replace("'", "\\'")';
                                        $el.closest('form').querySelector('[name=ClienteId]').value = '@c.Id';
                                        open = false">
                                @c.NomeCliente
                                @if (!string.IsNullOrWhiteSpace(c.Documento))
                                {
                                    <span class="text-gray-400 ml-1">- @c.Documento</span>
                                }
                            </button>
                        }
                    </div>
                </div>
                <span asp-validation-for="ClienteId" class="text-red-500 text-xs mt-1 block"></span>
                <select name="ClienteId" asp-for="ClienteId" class="hidden">
                    <option value="">Selecione...</option>
                    @foreach (var c in Model.Clientes)
                    {
                        <option value="@c.Id">@c.NomeCliente</option>
                    }
                </select>
            </div>

            <!-- Técnico -->
            <div>
                <label asp-for="TecnicoId" class="form-label">Técnico Responsável <span class="text-red-500">*</span></label>
                <select asp-for="TecnicoId" class="form-select">
                    <option value="">Selecione o técnico...</option>
                    @foreach (var u in Model.Usuarios)
                    {
                        <option value="@u.Id">@u.Nome</option>
                    }
                </select>
                <span asp-validation-for="TecnicoId" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Status -->
            <div>
                <label asp-for="Status" class="form-label">Status <span class="text-red-500">*</span></label>
                <select asp-for="Status" class="form-select">
                    @foreach (var s in Model.StatusList)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
                <span asp-validation-for="Status" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Data Inicial -->
            <div>
                <label asp-for="DataInicial" class="form-label">Data Inicial</label>
                <input asp-for="DataInicial" type="date" class="form-input" />
                <span asp-validation-for="DataInicial" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Data Final -->
            <div>
                <label asp-for="DataFinal" class="form-label">Data Final (Previsão)</label>
                <input asp-for="DataFinal" type="date" class="form-input" />
                <span asp-validation-for="DataFinal" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Garantia -->
            <div>
                <label asp-for="Garantia" class="form-label">Garantia</label>
                <input asp-for="Garantia" type="text" placeholder="Ex: 90 dias" class="form-input" />
                <span asp-validation-for="Garantia" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Valor Total -->
            <div>
                <label asp-for="ValorTotal" class="form-label">Valor Total (R$)</label>
                <div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="ValorTotal" class="form-input pl-9"  placeholder="0,00" /></div>
                <span asp-validation-for="ValorTotal" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Descrição do Produto -->
            <div class="md:col-span-2">
                <label asp-for="DescricaoProduto" class="form-label">Descrição do Produto / Equipamento</label>
                <textarea asp-for="DescricaoProduto" rows="3" class="form-input"
                          placeholder="Descreva o produto ou equipamento..."></textarea>
                <span asp-validation-for="DescricaoProduto" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Defeito -->
            <div class="md:col-span-2">
                <label asp-for="Defeito" class="form-label">Defeito / Problema Relatado</label>
                <textarea asp-for="Defeito" rows="3" class="form-input"
                          placeholder="Descreva o defeito ou problema..."></textarea>
                <span asp-validation-for="Defeito" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Observações -->
            <div class="md:col-span-2">
                <label asp-for="Observacoes" class="form-label">Observações</label>
                <textarea asp-for="Observacoes" rows="3" class="form-input"
                          placeholder="Observações internas..."></textarea>
                <span asp-validation-for="Observacoes" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>
    </div>

    <div class="flex justify-end gap-3">
        <a href="/Os" class="btn-secondary">Cancelar</a>
        <button type="submit" class="btn-primary">
            <i class='bx bx-save mr-1'></i> Criar OS
        </button>
    </div>
</form>

@section Scripts {
<script>
function osAdicionar() {
    return {};
}
</script>
}
