@page "{id:int}"
@model mapos_dotnet.Pages.Os.EditarModel
@{ ViewData["Title"] = "Editar OS"; }

<div class="flex items-center gap-3 mb-6">
    <a href="/Os/Visualizar/@Model.OsId" class="text-gray-400 hover:text-gray-600"><i class='bx bx-arrow-back text-xl'></i></a>
    <h1 class="text-2xl font-bold text-gray-900">Editar OS #@Model.OsId</h1>
</div>

<div class="card max-w-2xl">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input asp-for="OsId" type="hidden" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label asp-for="ClienteId" class="form-label">Cliente <span class="text-red-500">*</span></label>
                    <select asp-for="ClienteId" class="form-select">
                        @foreach (var c in Model.Clientes) { <option value="@c.Id">@c.NomeCliente</option> }
                    </select>
                    <span asp-validation-for="ClienteId" class="form-error"></span>
                </div>
                <div>
                    <label asp-for="TecnicoId" class="form-label">Técnico <span class="text-red-500">*</span></label>
                    <select asp-for="TecnicoId" class="form-select">
                        @foreach (var u in Model.Usuarios) { <option value="@u.Id">@u.Nome</option> }
                    </select>
                    <span asp-validation-for="TecnicoId" class="form-error"></span>
                </div>
                <div>
                    <label asp-for="DataInicial" class="form-label">Data Inicial</label>
                    <input asp-for="DataInicial" type="date" class="form-input" />
                </div>
                <div>
                    <label asp-for="DataFinal" class="form-label">Previsão de Entrega</label>
                    <input asp-for="DataFinal" type="date" class="form-input" />
                </div>
                <div>
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        @foreach (var s in Model.StatusList) { <option>@s</option> }
                    </select>
                </div>
                <div>
                    <label asp-for="Garantia" class="form-label">Garantia</label>
                    <input asp-for="Garantia" type="text" class="form-input" placeholder="Ex: 90 dias" />
                </div>
            </div>
            <div class="space-y-4 mt-5">
                <div>
                    <label asp-for="DescricaoProduto" class="form-label">Descrição do Produto/Equipamento</label>
                    <textarea asp-for="DescricaoProduto" rows="3" class="form-input"></textarea>
                </div>
                <div>
                    <label asp-for="Defeito" class="form-label">Defeito Relatado</label>
                    <textarea asp-for="Defeito" rows="3" class="form-input"></textarea>
                </div>
                <div>
                    <label asp-for="Observacoes" class="form-label">Observações</label>
                    <textarea asp-for="Observacoes" rows="3" class="form-input"></textarea>
                </div>
                <div>
                    <label asp-for="LaudoTecnico" class="form-label">Laudo Técnico</label>
                    <textarea asp-for="LaudoTecnico" rows="4" class="form-input"></textarea>
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button type="submit" class="btn-primary"><i class='bx bx-save'></i> Salvar</button>
                <a href="/Os/Visualizar/@Model.OsId" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
