@page
@model mapos_dotnet.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
    var baseUrl = "/Clientes?q=" + Uri.EscapeDataString(Model.Q ?? "") + (Model.FiltroFornecedor ? "&fornecedor=true" : "");
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Clientes</h1>
        <p class="text-sm text-gray-500 mt-0.5">Gerencie os clientes e fornecedores</p>
    </div>
    @if (Model.PodeAdicionar)
    {
        <a href="/Clientes/Adicionar" class="btn-primary">
            <i class='bx bx-plus'></i>
            Novo Cliente
        </a>
    }
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="flex flex-wrap gap-3 items-end">
            <div class="flex-1 min-w-48">
                <label class="form-label">Buscar</label>
                <input type="search" name="q" value="@Model.Q" placeholder="Nome ou documento..."
                       class="form-input" />
            </div>
            <div class="flex items-center gap-2 pb-1">
                <input type="checkbox" id="fornecedor" name="fornecedor" value="true"
                       @(Model.FiltroFornecedor ? "checked" : "")
                       class="w-4 h-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                <label for="fornecedor" class="text-sm text-gray-700">Somente fornecedores</label>
            </div>
            <button type="submit" class="btn-primary">
                <i class='bx bx-search'></i>
                Filtrar
            </button>
            @if (!string.IsNullOrEmpty(Model.Q) || Model.FiltroFornecedor)
            {
                <a href="/Clientes" class="btn-secondary">
                    <i class='bx bx-x'></i>
                    Limpar
                </a>
            }
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Clientes.Count == 0)
        {
            <div class="py-16 text-center text-gray-400">
                <i class='bx bx-user-x text-5xl mb-3 block'></i>
                <p class="text-lg font-medium">Nenhum cliente encontrado</p>
                <p class="text-sm mt-1">Tente ajustar os filtros ou cadastre um novo cliente.</p>
            </div>
        }
        else
        {
            <table class="table-mapos">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nome</th>
                        <th>Documento</th>
                        <th>Telefone / Celular</th>
                        <th>Cidade / Estado</th>
                        <th>Tipo</th>
                        <th class="text-right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in Model.Clientes)
                    {
                        <tr>
                            <td class="text-gray-400 text-sm">@cliente.Id</td>
                            <td class="font-medium">@cliente.NomeCliente</td>
                            <td class="text-gray-600">
                                @if (!string.IsNullOrEmpty(cliente.Documento))
                                {
                                    <span>@cliente.Documento</span>
                                    <span class="text-xs text-gray-400 ml-1">(@(cliente.PessoaFisica ? "CPF" : "CNPJ"))</span>
                                }
                                else
                                {
                                    <span class="text-gray-300">—</span>
                                }
                            </td>
                            <td class="text-gray-600">
                                @if (!string.IsNullOrEmpty(cliente.Telefone))
                                {
                                    <span>@cliente.Telefone</span>
                                }
                                @if (!string.IsNullOrEmpty(cliente.Celular))
                                {
                                    @if (!string.IsNullOrEmpty(cliente.Telefone)) { <span class="text-gray-300 mx-1">/</span> }
                                    <span>@cliente.Celular</span>
                                }
                                @if (string.IsNullOrEmpty(cliente.Telefone) && string.IsNullOrEmpty(cliente.Celular))
                                {
                                    <span class="text-gray-300">—</span>
                                }
                            </td>
                            <td class="text-gray-600">
                                @if (!string.IsNullOrEmpty(cliente.Cidade))
                                {
                                    @cliente.Cidade
                                    @if (!string.IsNullOrEmpty(cliente.Estado))
                                    {
                                        <span class="text-gray-400">/@cliente.Estado</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-gray-300">—</span>
                                }
                            </td>
                            <td>
                                @if (cliente.Fornecedor)
                                {
                                    <span class="badge badge-blue">Fornecedor</span>
                                }
                                else
                                {
                                    <span class="badge badge-green">Cliente</span>
                                }
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/Clientes/Visualizar/@cliente.Id" class="btn-secondary btn-sm">
                                        <i class='bx bx-show'></i>
                                    </a>
                                    <a href="/Clientes/Editar/@cliente.Id" class="btn-secondary btn-sm">
                                        <i class='bx bx-edit'></i>
                                        Editar
                                    </a>
                                    <form method="post" asp-page-handler="Excluir" asp-route-id="@cliente.Id"
                                          onsubmit="return confirm('Tem certeza que deseja excluir o cliente @Html.Raw(cliente.NomeCliente.Replace("'", "\\'"))?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-danger btn-sm">
                                            <i class='bx bx-trash'></i>
                                            Excluir
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="px-4 py-3 border-t border-gray-100">
                @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.TotalPages, baseUrl))
            </div>
        }
    </div>
</div>
