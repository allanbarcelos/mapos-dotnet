@page
@model mapos_dotnet.Pages.Clientes.AdicionarModel
@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="flex items-center gap-3 mb-6">
    <a href="/Clientes" class="text-gray-400 hover:text-gray-600">
        <i class='bx bx-arrow-back text-xl'></i>
    </a>
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Novo Cliente</h1>
        <p class="text-sm text-gray-500 mt-0.5">Preencha os dados para cadastrar um novo cliente</p>
    </div>
</div>

<div class="flex items-start gap-3 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 mb-6 text-sm text-blue-800">
    <i class='bx bx-shield-quarter text-xl flex-shrink-0 mt-0.5'></i>
    <div>
        <p class="font-semibold mb-0.5">Atenção: Lei Geral de Proteção de Dados (LGPD — Lei 13.709/2018)</p>
        <p class="text-blue-700">Colete apenas os dados estritamente necessários para a prestação do serviço. Dados sensíveis como CPF, endereço e contato devem ter finalidade justificada. Evite solicitar informações que não serão utilizadas — o titular tem direito de saber para que seus dados são usados e pode solicitar exclusão a qualquer momento.</p>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Dados principais -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Identificação -->
            <div class="card">
                <div class="card-header">
                    <h2 class="font-semibold text-gray-800">
                        <i class='bx bx-user mr-2'></i>Identificação
                    </h2>
                </div>
                <div class="card-body space-y-4">

                    <div>
                        <label asp-for="Input.NomeCliente" class="form-label">Nome <span class="text-red-500">*</span></label>
                        <input asp-for="Input.NomeCliente" class="form-input" placeholder="Nome completo ou razão social" />
                        <span asp-validation-for="Input.NomeCliente" class="form-error"></span>
                    </div>

                    <div>
                        <label class="form-label">Tipo de pessoa <span class="text-red-500">*</span></label>
                        <div class="flex gap-6 mt-1">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" asp-for="Input.PessoaFisica" value="true"
                                       class="w-4 h-4 text-primary-600 border-gray-300 focus:ring-primary-500" />
                                <span class="text-sm text-gray-700">Pessoa Física</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" asp-for="Input.PessoaFisica" value="false"
                                       class="w-4 h-4 text-primary-600 border-gray-300 focus:ring-primary-500" />
                                <span class="text-sm text-gray-700">Pessoa Jurídica</span>
                            </label>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Input.Sexo" class="form-label">Sexo</label>
                            <select asp-for="Input.Sexo" class="form-select">
                                <option value="">— Selecione —</option>
                                <option value="M">Masculino</option>
                                <option value="F">Feminino</option>
                                <option value="O">Outro</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="Input.Documento" class="form-label">CPF / CNPJ</label>
                            <input asp-for="Input.Documento" class="form-input" placeholder="000.000.000-00" />
                            <span asp-validation-for="Input.Documento" class="form-error"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Input.DataCadastro" class="form-label">Data de cadastro</label>
                        <input asp-for="Input.DataCadastro" type="date" class="form-input" />
                        <span asp-validation-for="Input.DataCadastro" class="form-error"></span>
                    </div>

                </div>
            </div>

            <!-- Contato -->
            <div class="card">
                <div class="card-header">
                    <h2 class="font-semibold text-gray-800">
                        <i class='bx bx-phone mr-2'></i>Contato
                    </h2>
                </div>
                <div class="card-body space-y-4">

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Input.Telefone" class="form-label">Telefone</label>
                            <input asp-for="Input.Telefone" class="form-input" placeholder="(00) 0000-0000" />
                            <span asp-validation-for="Input.Telefone" class="form-error"></span>
                        </div>
                        <div>
                            <label asp-for="Input.Celular" class="form-label">Celular</label>
                            <input asp-for="Input.Celular" class="form-input" placeholder="(00) 00000-0000" />
                            <span asp-validation-for="Input.Celular" class="form-error"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Input.Email" class="form-label">E-mail</label>
                            <input asp-for="Input.Email" type="email" class="form-input" placeholder="email@exemplo.com" />
                            <span asp-validation-for="Input.Email" class="form-error"></span>
                        </div>
                        <div>
                            <label asp-for="Input.Contato" class="form-label">Contato / Responsável</label>
                            <input asp-for="Input.Contato" class="form-input" placeholder="Nome do contato" />
                            <span asp-validation-for="Input.Contato" class="form-error"></span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Endereço -->
            <div class="card">
                <div class="card-header">
                    <h2 class="font-semibold text-gray-800">
                        <i class='bx bx-map mr-2'></i>Endereço
                    </h2>
                </div>
                <div class="card-body space-y-4">

                    <div class="grid grid-cols-3 gap-4">
                        <div class="col-span-2">
                            <label asp-for="Input.Rua" class="form-label">Rua / Logradouro</label>
                            <input asp-for="Input.Rua" class="form-input" placeholder="Nome da rua" />
                        </div>
                        <div>
                            <label asp-for="Input.Numero" class="form-label">Número</label>
                            <input asp-for="Input.Numero" class="form-input" placeholder="Nº" />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Input.Bairro" class="form-label">Bairro</label>
                            <input asp-for="Input.Bairro" class="form-input" placeholder="Bairro" />
                        </div>
                        <div>
                            <label asp-for="Input.Complemento" class="form-label">Complemento</label>
                            <input asp-for="Input.Complemento" class="form-input" placeholder="Apto, sala, bloco..." />
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-4">
                        <div>
                            <label asp-for="Input.Cep" class="form-label">CEP</label>
                            <input asp-for="Input.Cep" class="form-input" placeholder="00000-000" />
                        </div>
                        <div>
                            <label asp-for="Input.Cidade" class="form-label">Cidade</label>
                            <input asp-for="Input.Cidade" class="form-input" placeholder="Cidade" />
                        </div>
                        <div>
                            <label asp-for="Input.Estado" class="form-label">Estado</label>
                            <select asp-for="Input.Estado" class="form-select">
                                <option value="">— UF —</option>
                                <option value="AC">AC</option>
                                <option value="AL">AL</option>
                                <option value="AP">AP</option>
                                <option value="AM">AM</option>
                                <option value="BA">BA</option>
                                <option value="CE">CE</option>
                                <option value="DF">DF</option>
                                <option value="ES">ES</option>
                                <option value="GO">GO</option>
                                <option value="MA">MA</option>
                                <option value="MT">MT</option>
                                <option value="MS">MS</option>
                                <option value="MG">MG</option>
                                <option value="PA">PA</option>
                                <option value="PB">PB</option>
                                <option value="PR">PR</option>
                                <option value="PE">PE</option>
                                <option value="PI">PI</option>
                                <option value="RJ">RJ</option>
                                <option value="RN">RN</option>
                                <option value="RS">RS</option>
                                <option value="RO">RO</option>
                                <option value="RR">RR</option>
                                <option value="SC">SC</option>
                                <option value="SP">SP</option>
                                <option value="SE">SE</option>
                                <option value="TO">TO</option>
                            </select>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- Sidebar: Opções -->
        <div class="space-y-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="font-semibold text-gray-800">
                        <i class='bx bx-cog mr-2'></i>Opções
                    </h2>
                </div>
                <div class="card-body space-y-4">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input asp-for="Input.Fornecedor" type="checkbox"
                               class="mt-0.5 w-4 h-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                        <div>
                            <p class="text-sm font-medium text-gray-700">Fornecedor</p>
                            <p class="text-xs text-gray-400 mt-0.5">Marque se este cadastro é um fornecedor</p>
                        </div>
                    </label>
                </div>
            </div>

            <div class="flex flex-col gap-3">
                <button type="submit" class="btn-primary w-full justify-center">
                    <i class='bx bx-save'></i>
                    Salvar Cliente
                </button>
                <a href="/Clientes" class="btn-secondary w-full justify-center text-center">
                    Cancelar
                </a>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
