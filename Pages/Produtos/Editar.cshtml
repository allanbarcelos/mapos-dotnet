@page "{id:int}"
@model mapos_dotnet.Pages.Produtos.EditarModel
@{ ViewData["Title"] = "Editar Produto"; }

<div class="flex items-center gap-3 mb-6">
    <a href="/Produtos" class="text-gray-400 hover:text-gray-600"><i class='bx bx-arrow-back text-xl'></i></a>
    <h1 class="text-2xl font-bold text-gray-900">Editar Produto</h1>
</div>

<div class="card max-w-2xl card-body">
    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Input.Id" type="hidden" />
        <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div><label asp-for="Input.CodDeBarra" class="form-label">Código de Barras</label><input asp-for="Input.CodDeBarra" class="form-input" /></div>
                <div><label asp-for="Input.Unidade" class="form-label">Unidade</label><input asp-for="Input.Unidade" class="form-input" /></div>
            </div>
            <div><label asp-for="Input.Descricao" class="form-label">Descrição <span class="text-red-500">*</span></label><input asp-for="Input.Descricao" class="form-input" /></div>
            <div class="grid grid-cols-2 gap-4">
                <div><label asp-for="Input.PrecoCompra" class="form-label">Preço Compra</label><div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="Input.PrecoCompra" class="form-input pl-9"  placeholder="0,00" /></div></div>
                <div><label asp-for="Input.PrecoVenda" class="form-label">Preço Venda</label><div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="Input.PrecoVenda" class="form-input pl-9"  placeholder="0,00" /></div></div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div><label asp-for="Input.Estoque" class="form-label">Estoque</label><input asp-for="Input.Estoque" type="number" class="form-input" /></div>
                <div><label asp-for="Input.EstoqueMinimo" class="form-label">Estoque Mínimo</label><input asp-for="Input.EstoqueMinimo" type="number" class="form-input" /></div>
            </div>
            <div><label asp-for="Input.CategoriaId" class="form-label">Categoria</label><select asp-for="Input.CategoriaId" class="form-select"><option value="">Nenhuma</option>@foreach(var c in Model.Categorias){<option value="@c.Id">@c.Nome</option>}</select></div>
            <div class="flex gap-6">
                <label class="flex items-center gap-2 text-sm"><input asp-for="Input.Saida" type="checkbox" class="h-4 w-4" /> Permite Saída</label>
                <label class="flex items-center gap-2 text-sm"><input asp-for="Input.Entrada" type="checkbox" class="h-4 w-4" /> Permite Entrada</label>
            </div>
        </div>
        <div class="flex gap-3 mt-6"><button type="submit" class="btn-primary"><i class='bx bx-save'></i> Salvar</button><a href="/Produtos" class="btn-secondary">Cancelar</a></div>
    </form>
</div>
