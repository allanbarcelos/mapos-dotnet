@page
@model mapos_dotnet.Pages.Financeiro.AdicionarReceitaModel
@{ ViewData["Title"] = "Nova Receita"; }

<div class="flex items-center gap-3 mb-6">
    <a href="/Financeiro/Lancamentos" class="text-gray-400 hover:text-gray-600"><i class='bx bx-arrow-back text-xl'></i></a>
    <h1 class="text-2xl font-bold text-gray-900">Nova Receita</h1>
</div>

<div class="card max-w-2xl">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="space-y-5">
                <div>
                    <label asp-for="Input.Descricao" class="form-label">Descrição <span class="text-red-500">*</span></label>
                    <input asp-for="Input.Descricao" type="text" class="form-input" />
                    <span asp-validation-for="Input.Descricao" class="form-error"></span>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Input.Valor" class="form-label">Valor <span class="text-red-500">*</span></label>
                        <div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="Input.Valor" class="form-input pl-9"  placeholder="0,00" /></div>
                        <span asp-validation-for="Input.Valor" class="form-error"></span>
                    </div>
                    <div>
                        <label asp-for="Input.DataVencimento" class="form-label">Vencimento <span class="text-red-500">*</span></label>
                        <input asp-for="Input.DataVencimento" type="date" class="form-input" />
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Input.Desconto" class="form-label">Desconto</label>
                        <div class="relative"><span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-sm pointer-events-none select-none">R$</span><input type="text" data-money asp-for="Input.Desconto" class="form-input pl-9"  placeholder="0,00" /></div>
                    </div>
                    <div>
                        <label asp-for="Input.TipoDesconto" class="form-label">Tipo Desconto</label>
                        <select asp-for="Input.TipoDesconto" class="form-select">
                            <option value="real">Valor (R$)</option>
                            <option value="percent">Percentual (%)</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label asp-for="Input.ClienteId" class="form-label">Cliente/Fornecedor</label>
                    <select asp-for="Input.ClienteId" class="form-select">
                        <option value="">Nenhum</option>
                        @foreach (var c in Model.Clientes) { <option value="@c.Id">@c.NomeCliente</option> }
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Input.CategoriaId" class="form-label">Categoria</label>
                        <select asp-for="Input.CategoriaId" class="form-select">
                            <option value="">Nenhuma</option>
                            @foreach (var c in Model.Categorias) { <option value="@c.Id">@c.Nome</option> }
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.ContaId" class="form-label">Conta</label>
                        <select asp-for="Input.ContaId" class="form-select">
                            <option value="">Nenhuma</option>
                            @foreach (var c in Model.Contas) { <option value="@c.Id">@c.Nome</option> }
                        </select>
                    </div>
                </div>
                <div>
                    <label asp-for="Input.FormaPgto" class="form-label">Forma de Pagamento</label>
                    <input asp-for="Input.FormaPgto" type="text" class="form-input" placeholder="PIX, Boleto, Cartão..." />
                </div>
                <div>
                    <label asp-for="Input.Observacoes" class="form-label">Observações</label>
                    <textarea asp-for="Input.Observacoes" rows="3" class="form-input"></textarea>
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button type="submit" class="btn-success"><i class='bx bx-save'></i> Salvar Receita</button>
                <a href="/Financeiro/Lancamentos" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
