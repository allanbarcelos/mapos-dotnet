@page
@model mapos_dotnet.Pages.Financeiro.ParcelarModel
@{ ViewData["Title"] = "Parcelamento"; }

<div class="flex items-center gap-3 mb-6">
    <a href="/Financeiro/Lancamentos" class="text-gray-400 hover:text-gray-600"><i class='bx bx-arrow-back text-xl'></i></a>
    <h1 class="text-2xl font-bold text-gray-900">Novo Parcelamento</h1>
</div>

<div class="card max-w-2xl" x-data="parcelar()" x-init="calcular()">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="space-y-5">

                <div>
                    <label asp-for="Input.Tipo" class="form-label">Tipo <span class="text-red-500">*</span></label>
                    <select asp-for="Input.Tipo" class="form-select">
                        <option value="receita">Receita</option>
                        <option value="despesa">Despesa</option>
                    </select>
                </div>

                <div>
                    <label asp-for="Input.Descricao" class="form-label">Descrição <span class="text-red-500">*</span></label>
                    <input asp-for="Input.Descricao" class="form-input" />
                    <span asp-validation-for="Input.Descricao" class="form-error"></span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Input.ValorTotal" class="form-label">Valor Total <span class="text-red-500">*</span></label>
                        <input asp-for="Input.ValorTotal" type="number" step="0.01" min="0.01" class="form-input"
                               x-model="valorTotal" @@input="calcular()" />
                        <span asp-validation-for="Input.ValorTotal" class="form-error"></span>
                    </div>
                    <div>
                        <label asp-for="Input.Entrada" class="form-label">Entrada</label>
                        <input asp-for="Input.Entrada" type="number" step="0.01" min="0" class="form-input"
                               x-model="entrada" @@input="calcular()" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Input.QtdParcelas" class="form-label">Número de Parcelas <span class="text-red-500">*</span></label>
                        <input asp-for="Input.QtdParcelas" type="number" min="1" max="360" class="form-input"
                               x-model="qtd" @@input="calcular()" />
                        <span asp-validation-for="Input.QtdParcelas" class="form-error"></span>
                    </div>
                    <div>
                        <label asp-for="Input.DataPrimeiraParcela" class="form-label">Data 1ª Parcela <span class="text-red-500">*</span></label>
                        <input asp-for="Input.DataPrimeiraParcela" type="date" class="form-input" />
                    </div>
                </div>

                <!-- Preview -->
                <div class="bg-blue-50 rounded-lg p-4 text-sm" x-show="valorTotal > 0">
                    <p class="font-medium text-blue-800 mb-2">Resumo do parcelamento</p>
                    <div class="space-y-1 text-blue-700">
                        <p x-show="entrada > 0">Entrada: <strong x-text="'R$ ' + parseFloat(entrada || 0).toFixed(2)"></strong></p>
                        <p><span x-text="qtd"></span>x de <strong x-text="'R$ ' + valorParcela.toFixed(2)"></strong></p>
                        <p class="text-xs text-blue-500" x-show="resto < 0">⚠ Entrada maior que o valor total</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Input.Desconto" class="form-label">Desconto</label>
                        <input asp-for="Input.Desconto" type="number" step="0.01" class="form-input" />
                    </div>
                    <div>
                        <label asp-for="Input.TipoDesconto" class="form-label">Tipo Desconto</label>
                        <select asp-for="Input.TipoDesconto" class="form-select">
                            <option value="real">Valor (R$)</option>
                            <option value="percent">Percentual (%)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label asp-for="Input.ClienteId" class="form-label">Cliente/Fornecedor</label>
                    <select asp-for="Input.ClienteId" class="form-select">
                        <option value="">Nenhum</option>
                        @foreach (var c in Model.Clientes) { <option value="@c.Id">@c.NomeCliente</option> }
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Input.CategoriaId" class="form-label">Categoria</label>
                        <select asp-for="Input.CategoriaId" class="form-select">
                            <option value="">Nenhuma</option>
                            @foreach (var c in Model.Categorias) { <option value="@c.Id">@c.Nome</option> }
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.ContaId" class="form-label">Conta</label>
                        <select asp-for="Input.ContaId" class="form-select">
                            <option value="">Nenhuma</option>
                            @foreach (var c in Model.Contas) { <option value="@c.Id">@c.Nome</option> }
                        </select>
                    </div>
                </div>

                <div>
                    <label asp-for="Input.FormaPgto" class="form-label">Forma de Pagamento</label>
                    <input asp-for="Input.FormaPgto" class="form-input" placeholder="PIX, Boleto, Cartão..." />
                </div>

                <div>
                    <label asp-for="Input.Observacoes" class="form-label">Observações</label>
                    <textarea asp-for="Input.Observacoes" rows="3" class="form-input"></textarea>
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button type="submit" class="btn-primary"><i class='bx bx-calendar-check'></i> Criar Parcelamento</button>
                <a href="/Financeiro/Lancamentos" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function parcelar() {
    return {
        valorTotal: @Model.Input.ValorTotal,
        entrada:    @Model.Input.Entrada,
        qtd:        @Model.Input.QtdParcelas,
        valorParcela: 0,
        resto: 0,
        calcular() {
            const v = parseFloat(this.valorTotal) || 0;
            const e = parseFloat(this.entrada) || 0;
            const q = parseInt(this.qtd) || 1;
            this.resto = v - e;
            this.valorParcela = this.resto > 0 ? this.resto / q : 0;
        }
    };
}
</script>
}
