# Copie este arquivo para .env e preencha os valores.
# .env é ignorado pelo git — nunca faça commit dele.

# Credenciais PostgreSQL (dev — prod usa Docker secrets)
POSTGRES_DB=mapos
POSTGRES_USER=mapos_user
POSTGRES_PASSWORD=troque_esta_senha

# Senha do usuário admin criado no seed inicial
ADMIN_PASSWORD=troque_esta_senha

# SMTP para envio da fila de e-mails
# make setup gera secrets/ a partir destes valores
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=true
SMTP_USERNAME=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=seuemail@gmail.com

# MercadoPago — deixe em branco para desabilitar o gateway
# Obtenha em: https://www.mercadopago.com.br/developers/panel/credentials
MP_ACCESS_TOKEN=
MP_BOLETO_EXPIRATION=P3D
